# ShopStack — Local-first defaults
# Generated 2026-06-07

# ---- Runtime ----
SHOPSTACK_OFF_THE_GRID=false         # Allow non-mock provider backends
SHOPSTACK_PLANNER_BACKEND=local      # Use LocalProvider (MLX on Apple Silicon)

# ---- Model paths (optional if defaults are correct) ----
SHOPSTACK_LOCAL_AUTO_DOWNLOAD=true   # Auto-download GGUF model if missing
SHOPSTACK_LOCAL_MODEL_REPO=unsloth/Llama-3.2-3B-Instruct-GGUF
SHOPSTACK_LOCAL_MODEL_FILE=Llama-3.2-3B-Instruct-Q4_K_M.gguf

# ---- STT (set to local_whisper for on-device speech-to-text) ----
# SHOPSTACK_STT_BACKEND=local_whisper

# ---- API keys (only needed for cloud fallback) ----
# SHOPSTACK_OPENAI_API_KEY=sk-...
