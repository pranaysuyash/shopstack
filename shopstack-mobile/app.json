{
  "expo": {
    "name": "ShopStack",
    "slug": "shopstack-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "shopstack",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shopstack.mobile"
    },
    "android": {
      "package": "com.shopstack.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
