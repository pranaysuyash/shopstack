#!/usr/bin/env python3
"""Update README.md status sections with live test/benchmark counts."""
import subprocess
import re
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
README = REPO / "README.md"


def run(cmd: list[str], timeout: int = 30) -> str:
    result = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, cwd=REPO)
    return result.stdout


def extract_summary(output: str) -> str:
    m = re.search(r"(\d+) passed.*?in [\d.]+[sm]", output)
    return m.group(0) if m else ""


def extract_count(output: str) -> str:
    m = re.search(r"^.*?(\d+) passed.*?$", output, re.MULTILINE)
    return m.group(0).strip() if m else ""


test_output = run(["uv", "run", "pytest", "tests/", "-q"])
test_summary = extract_summary(test_output)

bench_output = run(["uv", "run", "pytest", "benchmarks/", "-q", "-m", "benchmark"])
bench_summary = extract_summary(bench_output)

readme_text = README.read_text()

# Replace test count line
if test_summary:
    readme_text = re.sub(
        r"uv run pytest tests/ -v          # .*$",
        f"uv run pytest tests/ -v          # {test_summary}",
        readme_text,
        flags=re.MULTILINE,
    )
if bench_summary:
    readme_text = re.sub(
        r"uv run pytest benchmarks/ -v -m benchmark  # .*$",
        f"uv run pytest benchmarks/ -v -m benchmark  # {bench_summary}",
        readme_text,
        flags=re.MULTILINE,
    )

README.write_text(readme_text)
print(f"README synced: tests={test_summary}, benchmarks={bench_summary}")
